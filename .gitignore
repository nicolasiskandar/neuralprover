__pycache__/
*.py[cod]
.venv/
lean/.lake/
data/cache/
data/mathlib-info-tree-*/
# The theorem-statement corpus is reproducible from the pinned Lean/Mathlib
# dump commands recorded in its metadata; keep the generated gzip out of git.
data/lemma_statements.jsonl.gz
checkpoints/
# Trainer artifacts are reproducible from the pinned model revision: the
# adapter weights, the optimizer/scheduler/rng state, and the tokenizer copy.
# The run's own description (README, adapter_config, trainer_state) stays
# tracked so the experiment remains documented.
experiments/**/adapter_model.safetensors
experiments/**/optimizer.pt
experiments/**/rng_state.pth
experiments/**/scheduler.pt
experiments/**/tokenizer.json
experiments/**/vocab.json
experiments/**/merges.txt
